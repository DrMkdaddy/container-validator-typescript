{
  "name": "@noor-mkdad/container-validator-client",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for ISO 6346 Container & Chassis Check-Digit Validator",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "iso-6346",
    "container",
    "shipping",
    "check-digit",
    "chassis",
    "intermodal",
    "freight",
    "logistics",
    "bic-code"
  ],
  "author": "Noor Mkdad",
  "license": "MIT",
  "homepage": "https://noormkdad.com/tools/container-validator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrMkdaddy/container-validator-typescript.git"
  }
}